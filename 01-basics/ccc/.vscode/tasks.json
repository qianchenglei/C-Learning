{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-all",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "main.c",
                "shunxubiao.c",
                "-o",
                "database.exe"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build & run（在下方终端运行）",
            "type": "shell",
            "command": "gcc -g main.c shunxubiao.c -o database.exe && ./database.exe",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        }
    ]
}